datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------
enum OrganizationRole {
  OWNER
  ADMINISTRATOR
  QA_MANAGER
  QA_ENGINEER
  AUTOMATION_ENGINEER
  DEVELOPER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectRole {
  PROJECT_LEAD
  MEMBER
  VIEWER
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

enum TestCaseStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum TestType {
  FUNCTIONAL
  REGRESSION
  SMOKE
  SANITY
  INTEGRATION
  SYSTEM
  ACCEPTANCE
  PERFORMANCE
  SECURITY
  USABILITY
  ACCESSIBILITY
  EXPLORATORY
}

enum TestPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ExecutionStatus {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
  SKIPPED
  RETEST
}

enum TestPlanStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum TestRunStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum DefectSeverity {
  CRITICAL
  HIGH
  MAJOR
  MEDIUM
  MODERATE
  LOW
  MINOR
  TRIVIAL
}

enum DefectPriority {
  URGENT
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum DefectStatus {
  NEW
  OPEN
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  FIXED
  READY_FOR_RETEST
  VERIFIED
  CLOSED
  REOPENED
  REJECTED
  DUPLICATE
}

enum DefectType {
  FUNCTIONAL
  UI
  API
  PERFORMANCE
  SECURITY
  ACCESSIBILITY
  DATA
  INTEGRATION
  OTHER
}

enum BillingTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum AIProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
  MOCK
  CUSTOM
}

enum AITaskType {
  TEST_GENERATION
  FAILURE_ANALYSIS
  DUPLICATE_DETECTION
  RISK_ANALYSIS
  QA_REPORT_SUMMARY
}

enum AIGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AIReviewStatus {
  PROPOSED
  ACCEPTED
  MODIFIED
  REJECTED
}

enum AIFeedbackRating {
  HELPFUL
  NOT_HELPFUL
  INACCURATE
  INCOMPLETE
}

// ----------------------------------------------------
// AUTH & MULTI-TENANCY
// ----------------------------------------------------
model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  passwordHash         String
  firstName            String
  lastName             String
  isSuperAdmin         Boolean              @default(false)
  isEmailVerified      Boolean              @default(false)
  avatarUrl            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  memberships          OrganizationMember[]
  projectMemberships   ProjectMember[]
  assignedDefects      Defect[]             @relation("DefectAssignee")
  reportedDefects      Defect[]             @relation("DefectReporter")
  qaOwnedDefects       Defect[]             @relation("DefectQaOwner")
  defectComments       DefectComment[]
  defectHistories      DefectHistory[]
  assignedTestRuns     TestRun[]            @relation("TestRunAssignee")
  createdTestRuns      TestRun[]            @relation("TestRunCreator")
  assignedRunCases     TestRunCase[]        @relation("RunCaseAssignee")
  managedTestPlans     TestPlan[]           @relation("TestPlanManager")
  executedResults      TestResult[]         @relation("ResultExecutor")
  uploadedAttachments  Attachment[]         @relation("AttachmentUploader")
  ownedMilestones      Milestone[]          @relation("MilestoneOwner")
  authoredTestCases    TestCase[]           @relation("TestCaseAuthor")
  createdCaseVersions  TestCaseVersion[]    @relation("VersionCreator")
  notifications        Notification[]
  notificationPref     NotificationPreference?
  auditLogs            AuditLog[]
  aiGenerations        AIGeneration[]
  aiFeedback           AIFeedback[]
  reviewedAIItems      AIGenerationItem[]   @relation("ReviewedAIItems")
  aiUsageLogs          AIUsageLog[]
  automationTokens     AutomationApiToken[] @relation("AutomationTokenCreator")
  refreshTokens        RefreshToken[]

  @@index([email])
}

model Organization {
  id                String               @id @default(uuid())
  name              String
  slug              String               @unique
  logoUrl           String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  members           OrganizationMember[]
  roles             Role[]
  invitations       Invitation[]
  subscription      Subscription?
  projects          Project[]
  auditLogs         AuditLog[]
  aiProviderConfigs AIProviderConfig[]
  aiGenerations     AIGeneration[]
  aiUsageLogs       AIUsageLog[]
  apiKeys           APIKey[]
  webhooks          Webhook[]
  automationTokens  AutomationApiToken[]
  automationSessions AutomationSession[]
  qualityGates      ProjectQualityGate[]
  reportSchedules   ReportSchedule[]
  reportExportJobs  ReportExportJob[]

  @@index([slug])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  customRoleId   String?
  joinedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole     Role?            @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Role {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  members        OrganizationMember[]

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(uuid())
  action      String           // e.g. "test_cases:create", "defects:close"
  description String?

  roles       RolePermission[]

  @@unique([action])
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole @default(VIEWER)
  tokenHash      String           @unique
  status         String           @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt      DateTime
  invitedById    String
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model RefreshToken {
  id             String       @id @default(uuid())
  userId         String
  organizationId String?
  tokenHash      String       @unique
  familyId       String       // Token rotation family for reuse detection
  isRevoked      Boolean      @default(false)
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model VerificationToken {
  id          String   @id @default(uuid())
  identifier  String   // User email
  tokenHash   String   @unique
  type        String   // "EMAIL_VERIFICATION", "PASSWORD_RESET"
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([identifier, type])
}

model BillingPlan {
  id              String         @id @default(uuid())
  name            String
  tier            BillingTier    @unique
  priceCentsMonth Int            @default(0)
  maxProjects     Int            @default(3)
  maxMembers      Int            @default(5)
  maxTestCases    Int            @default(500)
  maxTestRuns     Int            @default(100)
  maxAiRequests   Int            @default(100)
  storageMb       Int            @default(1024)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscriptions   Subscription[]
}

model Subscription {
  id             String       @id @default(uuid())
  organizationId String       @unique
  billingPlanId  String
  status         String       @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  currentPeriodEnd DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           BillingPlan  @relation(fields: [billingPlanId], references: [id])
}

// ----------------------------------------------------
// PROJECT MANAGEMENT
// ----------------------------------------------------
model Project {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  key            String          // Unique per organization, e.g. "CORE", "API"
  description    String?
  objectives     String?
  status         ProjectStatus   @default(ACTIVE)
  isArchived     Boolean         @default(false)
  archivedAt     DateTime?
  settings       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  environments   Environment[]
  milestones     Milestone[]
  testSuites     TestSuite[]
  testCases      TestCase[]
  tags           Tag[]
  testPlans      TestPlan[]
  testRuns       TestRun[]
  defects        Defect[]
  attachments    Attachment[]
  integrations   Integration[]
  aiGenerations  AIGeneration[]
  aiUsageLogs    AIUsageLog[]
  reportDefs     ReportDefinition[]
  reportSnapshots ReportSnapshot[]
  automationTokens AutomationApiToken[]
  automationMappings AutomationTestMapping[]
  automationSessions AutomationSession[]
  automationWebhooks AutomationWebhookEvent[]
  automationUnmapped AutomationUnmappedTest[]
  qualityGates       ProjectQualityGate[]
  reportSchedules    ReportSchedule[]
  reportExportJobs   ReportExportJob[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, isArchived])
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Environment {
  id          String    @id @default(uuid())
  projectId   String
  name        String    // e.g. "Dev", "Staging", "Prod"
  type        String    @default("CUSTOM") // DEVELOPMENT, TESTING, STAGING, PRODUCTION, CUSTOM
  url         String?
  description String?
  variables   Json?     // Environment configuration / variables
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlans   TestPlan[]
  testRuns    TestRun[]
  defects     Defect[]

  @@unique([projectId, name])
  @@index([projectId])
}

// ----------------------------------------------------
// MILESTONES & TEST REPOSITORY
// ----------------------------------------------------
model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  name        String
  description String?
  objectives  String?
  status      MilestoneStatus @default(PLANNED)
  priority    TestPriority    @default(MEDIUM)
  releaseVer  String?
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  ownerId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?           @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  testPlans   TestPlan[]
  testRuns    TestRun[]
  testCases   TestCase[]
  defects     Defect[]

  @@index([projectId])
  @@index([ownerId])
}

model TestSuite {
  id          String      @id @default(uuid())
  projectId   String
  parentId    String?
  name        String
  description String?
  objectives  String?
  orderIndex  Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      TestSuite?  @relation("SuiteHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    TestSuite[] @relation("SuiteHierarchy")
  testCases   TestCase[]

  @@index([projectId])
  @@index([parentId])
}

model Tag {
  id        String     @id @default(uuid())
  projectId String
  name      String
  color     String     @default("#3B82F6")
  createdAt DateTime   @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCase[]
  defects   Defect[]

  @@unique([projectId, name])
  @@index([projectId])
}

model TestCase {
  id               String            @id @default(uuid())
  projectId        String
  suiteId          String?
  milestoneId      String?
  caseNumber       Int               // Sequential number within project, e.g. 101 -> CORE-101
  title            String
  description      String?
  preconditions    String?
  objectives       String?
  requirementRef   String?           // External requirement identifier (e.g. "REQ-101", "JIRA-452")
  acceptanceCriteria String?         // Acceptance criteria specification
  priority         TestPriority      @default(MEDIUM)
  type             TestType          @default(FUNCTIONAL)
  status           TestCaseStatus    @default(ACTIVE)
  estimatedTimeMin Int?
  isArchived       Boolean           @default(false)
  currentVersion   Int               @default(1)
  authorId         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite            TestSuite?        @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  milestone        Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  author           User?             @relation("TestCaseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  tags             Tag[]
  versions         TestCaseVersion[]
  planCases        TestPlanCase[]
  defectLinks      DefectTestLink[]
  generatedFromAIItems AIGenerationItem[]
  automationMappings AutomationTestMapping[]

  @@unique([projectId, caseNumber])
  @@index([projectId])
  @@index([suiteId])
  @@index([milestoneId])
}

model TestCaseVersion {
  id            String            @id @default(uuid())
  testCaseId    String
  versionNumber Int
  title         String
  description   String?
  preconditions String?
  objectives    String?
  requirementRef String?
  acceptanceCriteria String?
  priority      TestPriority
  type          TestType
  status        TestCaseStatus    @default(ACTIVE)
  changeSummary String?
  createdById   String?
  createdAt     DateTime          @default(now())

  testCase      TestCase          @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("VersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  steps         TestStep[]
  runCases      TestRunCase[]
  planCases     TestPlanCase[]

  @@unique([testCaseId, versionNumber])
  @@index([testCaseId])
}

model TestStep {
  id                String          @id @default(uuid())
  testCaseVersionId String
  stepNumber        Int
  action            String
  testData          String?
  expectedResult    String

  version           TestCaseVersion @relation(fields: [testCaseVersionId], references: [id], onDelete: Cascade)

  @@unique([testCaseVersionId, stepNumber])
  @@index([testCaseVersionId])
}

// ----------------------------------------------------
// TEST PLANNING & EXECUTION ENGINE
// ----------------------------------------------------
model TestPlan {
  id             String         @id @default(uuid())
  projectId      String
  planNumber     Int            @default(1)
  milestoneId    String?
  environmentId  String?
  managerId      String?
  name           String
  description    String?
  objectives     String?
  scope          String?
  strategy       String?
  status         TestPlanStatus @default(DRAFT)
  priority       TestPriority   @default(MEDIUM)
  entryCriteria  String?
  exitCriteria   String?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  environment    Environment?   @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  manager        User?          @relation("TestPlanManager", fields: [managerId], references: [id], onDelete: SetNull)
  selectedCases  TestPlanCase[]
  testRuns       TestRun[]

  @@unique([projectId, planNumber])
  @@index([projectId])
  @@index([milestoneId])
  @@index([environmentId])
  @@index([managerId])
  @@index([projectId, status])
}

model TestPlanCase {
  id                String          @id @default(uuid())
  testPlanId        String
  testCaseId        String
  testCaseVersionId String?
  createdAt         DateTime        @default(now())

  testPlan          TestPlan        @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  testCase          TestCase        @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testCaseVersion   TestCaseVersion? @relation(fields: [testCaseVersionId], references: [id], onDelete: SetNull)

  @@unique([testPlanId, testCaseId])
  @@index([testPlanId])
  @@index([testCaseId])
  @@index([testCaseVersionId])
}

model TestRun {
  id            String         @id @default(uuid())
  projectId     String
  runNumber     Int            @default(1)
  testPlanId    String?
  milestoneId   String?
  environmentId String?
  assignedToId  String?
  createdById   String?
  name          String
  description   String?
  status        TestRunStatus  @default(NOT_STARTED)
  isAutomated   Boolean        @default(false)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlan      TestPlan?      @relation(fields: [testPlanId], references: [id], onDelete: SetNull)
  milestone     Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  environment   Environment?   @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("TestRunAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("TestRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  cases         TestRunCase[]
  defectLinks   DefectTestLink[]
  automationSessions AutomationSession[]

  @@unique([projectId, runNumber])
  @@index([projectId])
  @@index([testPlanId])
  @@index([milestoneId])
  @@index([environmentId])
  @@index([projectId, status])
}

model TestRunCase {
  id                String          @id @default(uuid())
  testRunId         String
  testCaseVersionId String
  assignedToId      String?
  status            ExecutionStatus @default(NOT_RUN)
  orderIndex        Int             @default(0)
  updatedAt         DateTime        @updatedAt

  testRun           TestRun         @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCaseVersion   TestCaseVersion @relation(fields: [testCaseVersionId], references: [id], onDelete: Cascade)
  assignedTo        User?           @relation("RunCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  results           TestResult[]

  @@unique([testRunId, testCaseVersionId])
  @@index([testRunId])
  @@index([testCaseVersionId])
  @@index([assignedToId])
}

model TestResult {
  id            String              @id @default(uuid())
  testRunCaseId String
  executedById  String?
  attemptNumber Int                 @default(1)
  status        ExecutionStatus
  actualResult  String?
  comment       String?
  failureReason String?
  durationMs    Int?
  executedAt    DateTime            @default(now())

  testRunCase   TestRunCase         @relation(fields: [testRunCaseId], references: [id], onDelete: Cascade)
  executedBy    User?               @relation("ResultExecutor", fields: [executedById], references: [id], onDelete: SetNull)
  stepResults   TestExecutionStep[]
  attachments   Attachment[]
  defectLinks   DefectTestLink[]

  @@index([testRunCaseId])
  @@index([executedById])
}

model TestExecutionStep {
  id           String          @id @default(uuid())
  testResultId String
  stepNumber   Int
  status       ExecutionStatus
  actualResult String?
  comment      String?
  durationMs   Int?

  testResult   TestResult      @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@unique([testResultId, stepNumber])
  @@index([testResultId])
}

// ----------------------------------------------------
// DEFECT MANAGEMENT
// ----------------------------------------------------
model Defect {
  id             String             @id @default(uuid())
  projectId      String
  environmentId  String?
  milestoneId    String?
  reporterId     String
  assigneeId     String?            // Assigned Developer
  qaOwnerId      String?            // QA Owner
  duplicateOfId  String?            // Canonical Defect reference
  defectNumber   Int                // e.g. CORE-BUG-1
  title          String
  description    String
  stepsToRepro   String?
  expectedResult String?
  actualResult   String?
  browserDevice  String?
  browser        String?
  os             String?
  appVersion     String?
  device         String?
  component      String?
  severity       DefectSeverity     @default(MEDIUM)
  priority       DefectPriority     @default(MEDIUM)
  status         DefectStatus       @default(NEW)
  type           DefectType         @default(FUNCTIONAL)
  dueDate        DateTime?
  resolution     String?
  rootCause      String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment    Environment?       @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  milestone      Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  reporter       User               @relation("DefectReporter", fields: [reporterId], references: [id])
  assignee       User?              @relation("DefectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  qaOwner        User?              @relation("DefectQaOwner", fields: [qaOwnerId], references: [id], onDelete: SetNull)
  duplicateOf    Defect?            @relation("DefectDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates     Defect[]           @relation("DefectDuplicates")
  tags           Tag[]
  comments       DefectComment[]
  history        DefectHistory[]
  testLinks      DefectTestLink[]
  attachments    Attachment[]
  assignments    DefectAssignment[]

  @@unique([projectId, defectNumber])
  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([assigneeId])
  @@index([qaOwnerId])
  @@index([duplicateOfId])
}

model DefectAssignment {
  id         String   @id @default(uuid())
  defectId   String
  userId     String
  assignedAt DateTime @default(now())

  defect     Defect   @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@index([defectId])
}

model DefectComment {
  id         String          @id @default(uuid())
  defectId   String
  userId     String
  parentId   String?
  content    String
  isInternal Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  defect     Defect          @relation(fields: [defectId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     DefectComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    DefectComment[] @relation("CommentReplies")

  @@index([defectId])
  @@index([parentId])
}

model DefectHistory {
  id        String   @id @default(uuid())
  defectId  String
  userId    String
  field     String
  oldValue  String?
  newValue  String?
  reason    String?
  changedAt DateTime @default(now())

  defect    Defect   @relation(fields: [defectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([defectId])
}

model DefectTestLink {
  id           String      @id @default(uuid())
  defectId     String
  testCaseId   String?
  testResultId String?
  testRunId    String?

  defect       Defect      @relation(fields: [defectId], references: [id], onDelete: Cascade)
  testCase     TestCase?   @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  testResult   TestResult? @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  testRun      TestRun?    @relation(fields: [testRunId], references: [id], onDelete: SetNull)

  @@index([defectId])
  @@index([testCaseId])
  @@index([testResultId])
  @@index([testRunId])
}

// ----------------------------------------------------
// ATTACHMENTS, AUDIT & NOTIFICATIONS
// ----------------------------------------------------
model Attachment {
  id           String      @id @default(uuid())
  projectId    String?
  fileName     String
  fileSize     Int
  mimeType     String
  fileUrl      String
  storageKey   String?
  uploadedById String?
  testResultId String?
  defectId     String?
  createdAt    DateTime    @default(now())

  project      Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User?       @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  testResult   TestResult? @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  defect       Defect?     @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([testResultId])
  @@index([defectId])
  @@index([uploadedById])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // e.g. "TEST_ASSIGNED", "DEFECT_STATUS"
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model NotificationPreference {
  id             String  @id @default(uuid())
  userId         String  @unique
  emailAlerts    Boolean @default(true)
  inAppAlerts    Boolean @default(true)
  defectUpdates  Boolean @default(true)
  testAssignment Boolean @default(true)
  weeklyDigest   Boolean @default(false)

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
}

// ----------------------------------------------------
// ARTIFICIAL INTELLIGENCE MODELS (Milestone 07)
// ----------------------------------------------------
model AIProviderConfig {
  id              String         @id @default(uuid())
  organizationId  String
  provider        AIProviderType
  apiKeyEncrypted String?
  apiKeyIv        String?
  apiKeyTag       String?
  modelName       String         @default("gpt-4o")
  apiEndpoint     String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model AIPromptTemplate {
  id                 String         @id @default(uuid())
  name               String
  description        String?
  taskType           AITaskType
  systemPrompt       String
  userPromptTemplate String
  version            Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  generations        AIGeneration[]

  @@unique([taskType, version])
}

model AIGeneration {
  id                 String             @id @default(uuid())
  projectId          String
  userId             String
  organizationId     String
  taskType           AITaskType
  provider           AIProviderType     @default(MOCK)
  modelName          String             @default("mock")
  promptTemplateId   String?
  promptVersion      Int?
  promptInput        String
  rawOutput          String?
  structuredOutput   Json?
  status             AIGenerationStatus @default(COMPLETED)
  errorMessage       String?
  tokenPrompt        Int                @default(0)
  tokenCompletion    Int                @default(0)
  tokenCount         Int                @default(0)
  estimatedCost      Float              @default(0.0)
  latencyMs          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promptTemplate     AIPromptTemplate?  @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  items              AIGenerationItem[]
  analysisResults    AIAnalysisResult[]
  feedback           AIFeedback[]
  evaluations        AIEvaluation[]

  @@index([projectId, taskType])
  @@index([organizationId])
}

model AIGenerationItem {
  id                  String         @id @default(uuid())
  generationId        String
  itemType            String         @default("TEST_CASE")
  title               String
  content             Json
  reviewStatus        AIReviewStatus @default(PROPOSED)
  isApproved          Boolean        @default(false)
  isRejected          Boolean        @default(false)
  reviewedById        String?
  reviewedAt          DateTime?
  persistedTestCaseId String?
  rejectionReason     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  generation          AIGeneration   @relation(fields: [generationId], references: [id], onDelete: Cascade)
  reviewedBy          User?          @relation("ReviewedAIItems", fields: [reviewedById], references: [id], onDelete: SetNull)
  persistedTestCase   TestCase?      @relation(fields: [persistedTestCaseId], references: [id], onDelete: SetNull)

  @@index([generationId])
  @@index([persistedTestCaseId])
}

model AIAnalysisResult {
  id                 String          @id @default(uuid())
  generationId       String?
  targetType         String          // "TEST_FAILURE", "DEFECT_DUPLICATE", "RISK_ANALYSIS", "QA_REPORT"
  targetId           String
  summary            String
  rootCause          String?
  hypotheses         Json?           // Potential causes with confidence scores (distinguished from facts)
  observedFacts      Json?           // Facts extracted from test execution / logs
  confidence         Float?
  recommendations    String[]        @default([])
  suggestedSeverity  DefectSeverity?
  suggestedPriority  DefectPriority?
  createdAt          DateTime        @default(now())

  generation         AIGeneration?   @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([generationId])
}

model AIUsageLog {
  id              String         @id @default(uuid())
  organizationId  String
  projectId       String?
  userId          String?
  feature         String
  provider        AIProviderType @default(MOCK)
  modelName       String         @default("mock")
  tokensUsed      Int            @default(0)
  tokensPrompt    Int            @default(0)
  tokensCompletion Int           @default(0)
  estimatedCost   Float          @default(0.0)
  durationMs      Int            @default(0)
  success         Boolean        @default(true)
  createdAt       DateTime       @default(now())

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId])
}

model AIFeedback {
  id             String            @id @default(uuid())
  generationId   String
  userId         String
  rating         Int               @default(5)
  ratingCategory AIFeedbackRating?
  comments       String?
  createdAt      DateTime          @default(now())

  generation     AIGeneration      @relation(fields: [generationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([generationId])
  @@index([userId])
}

model AIEvaluation {
  id                  String       @id @default(uuid())
  generationId        String
  schemaValid         Boolean      @default(true)
  requirementCoverage Float?
  hallucinationFlag   Boolean      @default(false)
  acceptanceRate      Float?
  createdAt           DateTime     @default(now())

  generation          AIGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId])
}

model AIEmbedding {
  id         String   @id @default(uuid())
  entityType String   // "TEST_CASE", "DEFECT"
  entityId   String
  embedding  Float[]
  textSample String?
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId])
}

// ----------------------------------------------------
// INTEGRATIONS, WEBHOOKS & REPORTING
// ----------------------------------------------------
model Integration {
  id          String   @id @default(uuid())
  projectId   String
  provider    String   // "PLAYWRIGHT", "POSTMAN", "GITHUB"
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Webhook {
  id             String       @id @default(uuid())
  organizationId String
  url            String
  secret         String
  events         String[]
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model APIKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  keyHash        String       @unique
  keyPrefix      String
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ----------------------------------------------------
// MILESTONE 09 — ADVANCED ANALYTICS & REPORTING
// ----------------------------------------------------

model ProjectQualityGate {
  id                        String       @id @default(uuid())
  projectId                 String
  organizationId            String
  name                      String       @default("Default Release Gate")
  description               String?
  minTestPassRate           Float        @default(90.0) // Minimum acceptable pass rate percentage
  maxCriticalDefects        Int          @default(0)    // Max allowed open CRITICAL defects
  maxHighDefects            Int          @default(2)    // Max allowed open HIGH/MAJOR defects
  minExecutionCoverage      Float        @default(80.0) // Minimum executed test cases percentage
  requireAllSuitesCompleted Boolean      @default(false)
  requireZeroBlockers       Boolean      @default(true) // No BLOCKED execution statuses allowed
  isDefault                 Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  project                   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@index([organizationId])
}

model ReportDefinition {
  id          String           @id @default(uuid())
  projectId   String
  name        String
  description String?
  type        String           @default("EXECUTIVE") // EXECUTIVE, TEST_EXECUTION, DEFECT_ANALYSIS, TEST_COVERAGE, AUTOMATION_PERFORMANCE, MILESTONE_RELEASE, AI_INTELLIGENCE
  metrics     Json?            // Array of selected metric keys
  dimensions  Json?            // Array of groupings (e.g. status, severity, environment, day)
  filters     Json             // Date range, environment, milestone, priority, etc.
  isTemplate  Boolean          @default(false)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots   ReportSnapshot[]
  schedules   ReportSchedule[]

  @@index([projectId])
}

model ReportSnapshot {
  id             String           @id @default(uuid())
  reportDefId    String?
  projectId      String
  name           String?
  type           String           @default("EXECUTIVE")
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?
  data           Json             // Frozen precomputed analytics snapshot data
  summary        Json?            // High-level KPI summary
  createdById    String?
  generatedAt    DateTime         @default(now())

  reportDef      ReportDefinition? @relation(fields: [reportDefId], references: [id], onDelete: SetNull)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([reportDefId])
  @@index([projectId])
  @@index([generatedAt])
}

model ReportSchedule {
  id             String           @id @default(uuid())
  reportDefId    String
  projectId      String
  organizationId String
  name           String
  frequency      String           @default("WEEKLY") // DAILY, WEEKLY, MONTHLY
  cronExpression String?
  recipients     Json             // Array of recipient email strings
  format         String           @default("PDF")    // PDF, CSV, XLSX
  isActive       Boolean          @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  reportDef      ReportDefinition @relation(fields: [reportDefId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     ReportDelivery[]

  @@index([projectId, isActive])
  @@index([reportDefId])
  @@index([organizationId])
}

model ReportDelivery {
  id           String         @id @default(uuid())
  scheduleId   String
  status       String         @default("SUCCESS") // SUCCESS, FAILED, PENDING
  recipients   Json           // Target recipients
  format       String         @default("PDF")
  fileUrl      String?
  errorMessage String?
  deliveredAt  DateTime       @default(now())

  schedule     ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([deliveredAt])
}

model ReportExportJob {
  id             String       @id @default(uuid())
  projectId      String
  organizationId String
  reportType     String       // EXECUTIVE, TEST_EXECUTION, DEFECT_ANALYSIS, TEST_COVERAGE, AUTOMATION_PERFORMANCE, MILESTONE_RELEASE, AI_INTELLIGENCE
  format         String       // CSV, XLSX, PDF
  status         String       @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  parameters     Json?
  fileName       String
  filePath       String?
  fileSize       Int?
  createdById    String?
  errorMessage   String?
  completedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([organizationId])
}

// ----------------------------------------------------
// MILESTONE 08 — AUTOMATION & CI/CD INTEGRATION
// ----------------------------------------------------

model AutomationApiToken {
  id             String       @id @default(uuid())
  projectId      String
  organizationId String
  name           String
  tokenPrefix    String       // e.g. "aiqa_auto_abc123"
  tokenHash      String       @unique // SHA-256 hash of raw token
  scopes         String[]     @default(["automation:ingest"])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isRevoked      Boolean      @default(false)
  revokedAt      DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("AutomationTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, isRevoked])
  @@index([organizationId])
  @@index([tokenHash])
}

model AutomationTestMapping {
  id            String       @id @default(uuid())
  projectId     String
  testCaseId    String
  externalId    String       // e.g. "TC-101", "tests/auth.spec.ts::User should log in"
  externalTitle String
  framework     String       @default("PLAYWRIGHT") // PLAYWRIGHT, NEWMAN, CYPRESS, GENERIC
  confidence    Float        @default(1.0)
  isVerified    Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase      TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalId])
  @@index([projectId])
  @@index([testCaseId])
}

model AutomationSession {
  id                 String                   @id @default(uuid())
  projectId          String
  organizationId     String
  testRunId          String?
  idempotencyKey     String?
  framework          String                   @default("PLAYWRIGHT") // PLAYWRIGHT, NEWMAN, GENERIC
  status             String                   @default("INITIALIZED") // INITIALIZED, INGESTING, COMPLETED, FAILED, ABORTED
  environmentId      String?
  milestoneId        String?
  ciProvider         String?                  // GITHUB_ACTIONS, GITLAB_CI, JENKINS, CIRCLECI, LOCAL
  ciBuildId          String?
  ciBuildUrl         String?
  gitBranch          String?
  gitCommitSha       String?
  gitCommitMessage   String?
  gitAuthor          String?
  pullRequestNumber  Int?
  os                 String?
  browser            String?
  totalTests         Int                      @default(0)
  passedTests        Int                      @default(0)
  failedTests        Int                      @default(0)
  skippedTests       Int                      @default(0)
  durationMs         Int                      @default(0)
  metadata           Json?
  startedAt          DateTime                 @default(now())
  completedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testRun            TestRun?                 @relation(fields: [testRunId], references: [id], onDelete: SetNull)
  unmappedTests      AutomationUnmappedTest[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, status])
  @@index([organizationId])
  @@index([testRunId])
}

model AutomationUnmappedTest {
  id                 String            @id @default(uuid())
  sessionId          String
  projectId          String
  externalId         String
  externalTitle      String
  suiteName          String?
  framework          String            @default("PLAYWRIGHT")
  lastSeenAt         DateTime          @default(now())
  status             String            @default("PENDING") // PENDING, RESOLVED, IGNORED
  resolvedTestCaseId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  session            AutomationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([sessionId])
}

model AutomationWebhookEvent {
  id           String   @id @default(uuid())
  projectId    String
  eventId      String   // e.g. X-GitHub-Delivery GUID
  eventType    String   // e.g. workflow_run, check_run
  signature    String
  payload      Json
  status       String   @default("PROCESSED") // PENDING, PROCESSED, FAILED, DUPLICATE
  errorMessage String?
  receivedAt   DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, eventId])
  @@index([projectId, receivedAt])
}
