# Node Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_qa_platform
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_qa_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Security & Authentication (Milestone 02)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_min32chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min32chars
SESSION_SECRET=dev_session_secret_change_in_production_min32chars
COOKIE_SECRET=dev_cookie_secret_change_in_production_min32chars

# AI Providers (Milestone 07)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Storage (S3 / MinIO)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
